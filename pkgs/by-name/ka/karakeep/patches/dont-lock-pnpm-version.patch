Karakeep pins a specific pnpm version and declares its pnpm config in
package.json (patchedDependencies) and .npmrc (node-linker). Newer pnpm
(>= 10) refuses the pinned version and only reads these settings from
pnpm-workspace.yaml. We unpin the version and move the config across so the
frozen-lockfile install keeps working, with the same hoisted node_modules
layout and the same patches applied.

---
--- a/package.json
+++ b/package.json
@@ -38,13 +38,9 @@
   },
-  "packageManager": "pnpm@9.15.9",
+  "packageManager": "pnpm",
   "pnpm": {
     "onlyBuiltDependencies": [
       "better-sqlite3",
       "re2"
-    ],
-    "patchedDependencies": {
-      "xcode@3.0.1": "patches/xcode@3.0.1.patch",
-      "playwright-extra@4.3.6": "patches/playwright-extra@4.3.6.patch"
-    }
+    ]
   }
 }
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -1,6 +1,12 @@
 packages:
   - "packages/*"
   - "apps/*"
   - "tooling/*"
   - "tools/*"
   - "docs"
+
+nodeLinker: hoisted
+
+patchedDependencies:
+  xcode@3.0.1: patches/xcode@3.0.1.patch
+  playwright-extra@4.3.6: patches/playwright-extra@4.3.6.patch
